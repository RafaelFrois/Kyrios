<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+: splash do sistema com a galinha no fundo escuro dos menus. -->
  <style name="Theme.MegRace" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@color/megrace_background</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    <item name="android:windowSplashScreenBackground">@color/megrace_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
  </style>
</resources>

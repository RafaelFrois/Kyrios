<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: o save vai no backup na nuvem e na transferência pra um aparelho novo. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="." />
  </device-transfer>
</data-extraction-rules>
